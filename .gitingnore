# ------------------------------------------------------------
# Logs & diagnostics
# ------------------------------------------------------------
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
report.[0-9]*.[0-9]*
coverage
*.lcov

# ------------------------------------------------------------
# OS junk
# ------------------------------------------------------------
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db
Icon?
.Spotlight-V100
.Trashes
*.swp
*.swo
*.orig

# ------------------------------------------------------------
# Dependencies
# (Never commit node_modules. Do commit lockfiles!)
# ------------------------------------------------------------
node_modules/
jspm_packages/

# ------------------------------------------------------------
# Build output / caches
# ------------------------------------------------------------
dist/
build/
out/
.tmp/
temp/
.cache/
.eslintcache
.stylelintcache
.parcel-cache/
.storybook-out/
storybook-static/
.wrangler/
.sass-cache/

# Vite / Vitest
.vite/
node_modules/.vite/
.vitest/

# Next.js / Nuxt / SvelteKit / Gatsby / Remix
.next/
out/
.vercel/
.nuxt/
.svelte-kit/
.cache-loader/
.public/
.netlify/

# Angular
.angular/

# Gatsby
.cache/
public/

# Expo / React Native web builds
.expo/
web-build/

# Webpack
webpack-stats*.json

# ------------------------------------------------------------
# Testing artifacts
# ------------------------------------------------------------
junit.xml
test-results/
playwright-report/
test-report/
playwright/.cache/
*.tsbuildinfo
# Cypress
cypress/videos/
cypress/screenshots/
cypress/downloads/
# Playwright
test-results/
blob-report/
.playwright/
# Jest
jest-html-reporters-*
jest-stare/

# ------------------------------------------------------------
# Environment & secrets
# (Keep .env.example tracked; ignore actual env files)
# ------------------------------------------------------------
.env
.env.*        # e.g. .env.local, .env.production
!.env.example
!.env.*.example

# ------------------------------------------------------------
# Editors & IDEs
# ------------------------------------------------------------
# VS Code (allow recommended settings/extensions if you like)
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# JetBrains
.idea/
*.iml

# Sublime
*.sublime-project
*.sublime-workspace

# Vim / Emacs
*~
.*.swp
.*.swo
.*.un~
\#*\#
.\#*

# ------------------------------------------------------------
# Package managers / monorepos
# (Lockfiles SHOULD be committed)
# ------------------------------------------------------------
.pnpm-debug.log*
.npm/
.pnpm-store/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Turbo / Nx
.turbo/
.nx/

# ------------------------------------------------------------
# Framework/host-specific
# ------------------------------------------------------------
# Firebase
.firebase/
functions/lib/
functions/node_modules/

# Serverless / Cloudflare
.serverless/
.workers/

# Docker (use .dockerignore too, but keep these out of git)
docker-data/
*.pid
*.seed
*.pid.lock

# ------------------------------------------------------------
# Misc
# ------------------------------------------------------------
# Local tooling
.envrc
direnv.toml
.vscode-test/
*.local
*.backup
*.bak
*.tmp
